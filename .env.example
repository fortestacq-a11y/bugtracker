# Copy to .env and edit. `docker compose` and `podman compose` read this file
# automatically from the repo root. .env is gitignored — never commit real values.

# ── Registry / image names ────────────────────────────────────────────────────
# Registry prefix used by scripts/docker-build.sh and scripts/docker-push.sh.
# Leave empty for local-only tags (localhost/ prefix, unpushed).
# REGISTRY=docker.io/your-username

# Version tag applied to the published images (default: git describe).
# VERSION=0.1.0

# ── API configuration ─────────────────────────────────────────────────────────
# JWT signing secret. REQUIRED — the app refuses to start without it, and there is
# deliberately no built-in default (a default inside the published image would mean
# anyone can mint a valid token for any user).
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48

# Database. These match scripts/db-up.sh; docker-compose.yml overrides DB_URL to
# point at the `db` service on the compose network.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=bugtracker
# DB_USER=buguser
# DB_PASSWORD=bugpass

# HTTP port the API listens on inside the container.
# SERVER_PORT=8080

# ── Web (nginx) configuration ─────────────────────────────────────────────────
# Where nginx proxies /api. Must be the compose service name when running the
# compose stack, or a hostname/IP when running the web image standalone.
# API_UPSTREAM=http://localhost:8080