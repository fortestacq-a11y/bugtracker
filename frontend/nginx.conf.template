# BugTracker web server config.
#
# This file is a TEMPLATE. The nginx image's entrypoint runs envsubst over
# /etc/nginx/templates/*.template before starting nginx, so ${API_UPSTREAM} is
# replaced at container start. Set API_UPSTREAM to point the proxy at a different
# backend (compose uses http://api:8080).
#
# Note on the nginx variables below ($uri, $host, ...): the entrypoint restricts
# substitution to API_* via NGINX_ENVSUBST_FILTER, so these survive untouched.
# Without that filter, any env var that happened to share a name with an nginx
# variable would silently blank it out.

server {
    # Decision: listen on ${PORT} so PaaS platforms work unmodified. Railway injects
    # PORT=8080 and routes its edge to that port; locally we default to 80 via the
    # Dockerfile's ENV. Hardcoding 80 here is the classic reason a container works on
    # your laptop and returns 502 everywhere else.
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    # SPA fallback: /login, /projects/2 etc. are client-side routes, so every unknown
    # path must return index.html and let the router resolve it. Without this,
    # refreshing the page on a deep link 404s.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite emits content-hashed filenames into /assets, so these URLs can never change
    # meaning — cache them hard. No `expires` directive: it would emit a second,
    # conflicting Cache-Control header alongside the one below.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # index.html points at the hashed bundle, so it must never be served stale after a
    # deploy. This location also catches `/` via the internal redirect above.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # All API traffic is same-origin from the browser's point of view: the client calls
    # relative '/api/...' and nginx forwards it. This is what removes CORS from the
    # production path entirely.
    location /api/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;

        # Decision: send SNI on the upstream TLS handshake. nginx does NOT do this by
        # default (proxy_ssl_server_name is off), so proxying to an https:// upstream
        # reaches a TLS terminator with no server name — most edges reject that and
        # nginx surfaces it as a bare 502 with a failed handshake in the error log.
        # Setting proxy_ssl_name alongside it keeps the cert check keyed to the host we
        # actually dialled rather than $host, which is the frontend's own name.
        proxy_ssl_server_name on;
        proxy_ssl_name       $proxy_host;

        # Decision: Host must be $proxy_host (the upstream from proxy_pass), NOT $host.
        # $host is the *client's* hostname — on a PaaS that is the frontend's own domain,
        # and the edge routes by Host, so forwarding it makes the backend unreachable
        # ("Application not found"). $proxy_host is the name we actually dialled.
        # This was invisible locally because Spring ignores Host; it only breaks behind
        # a Host-routing load balancer.
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The original client host is still worth preserving for the app to see.
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # Don't buffer API responses to disk: they are small JSON payloads and
        # buffering only adds latency.
        proxy_buffering off;
    }

    client_max_body_size 10m;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_proxied    any;
    gzip_types      text/plain text/css application/javascript application/json
                    image/svg+xml application/xml font/woff2;

    server_tokens off;
}